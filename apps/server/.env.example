# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ─── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/follac
REDIS_URL=redis://localhost:6379

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-random-32-char-secret
# Google OAuth (login + calendar). Redirect URIs to register:
#   {API_URL}/api/auth/callback/google
#   {API_URL}/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_LITE=gpt-4o-mini

# ─── Meeting bots (Recall.ai) ─────────────────────────────────────────────────
RECALL_API_KEY=
RECALL_BASE_URL=https://us-east-1.recall.ai
RECALL_WEBHOOK_SECRET=
BOT_LEAD_MINUTES=2
CALENDAR_SYNC_INTERVAL_MS=300000

# ─── Transcription (Deepgram — used by apps/worker) ───────────────────────────
DEEPGRAM_API_KEY=

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard, read at seed time (pnpm --filter @follac/db db:seed)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Follac AI <reports@follac.ai>"
