# ─── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/follac
REDIS_URL=redis://localhost:6379

# ─── Web app (deep links in report emails) ────────────────────────────────────
WEB_URL=http://localhost:3000

# ─── Transcription (Deepgram) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ─── Analysis (OpenAI) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Follac AI <reports@follac.ai>"
