{
  "name": "follac-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Follac AI — Context-aware AI browser assistant. Follow → Understand → Act.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:extension": "pnpm --filter @follac/extension build",
    "build:server": "pnpm --filter @follac/server build",
    "build:web": "pnpm --filter @follac/web build",
    "dev": "pnpm --filter @follac/extension dev & pnpm --filter @follac/server dev",
    "dev:extension": "pnpm --filter @follac/extension dev",
    "dev:server": "pnpm --filter @follac/server dev",
    "dev:web": "pnpm --filter @follac/web dev",
    "dev:worker": "pnpm --filter @follac/worker dev",
    "db:generate": "pnpm --filter @follac/db db:generate",
    "db:migrate": "pnpm --filter @follac/db db:migrate",
    "db:seed": "pnpm --filter @follac/db db:seed",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} + 2>/dev/null; find . -name '.turbo' -exec rm -rf {} + 2>/dev/null; echo 'Clean complete'",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
