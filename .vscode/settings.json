{
  "explorer.excludeGitIgnore": false,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "files.watcherExclude": {
    "**/.next/**": true
  },
  "search.exclude": {
    "**/.next": true
  }
}
